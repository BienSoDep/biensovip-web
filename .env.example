# Backend API base URL. Bỏ trống → app dùng mockData.js (H3 trong BACKEND-IMPLEMENTATION-PLAN.md)
VITE_API_URL=http://localhost:5080
# Facebook Fanpage ID cho Messenger Chat Plugin (UC05). Để trống → dùng Zalo (UC06) làm fallback.
VITE_FB_PAGE_ID=
# Google OAuth Client ID (UC29 đăng nhập Google, UC28/30 nút Google trong Collaborator.jsx).
# Lấy từ Google Cloud Console → Clients (phải khớp GoogleOAuth__ClientId phía backend).
VITE_GOOGLE_CLIENT_ID=
