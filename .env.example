# Backend API base URL. Bỏ trống → app dùng mockData.js (H3 trong BACKEND-IMPLEMENTATION-PLAN.md)
VITE_API_URL=http://localhost:5080
# Facebook Fanpage ID cho Messenger Chat Plugin (UC05). Để trống → dùng Zalo (UC06) làm fallback.
VITE_FB_PAGE_ID=
# Google OAuth Client ID (UC29 đăng nhập Google, UC28/30 nút Google trong Collaborator.jsx).
# Lấy từ Google Cloud Console → Clients (phải khớp GoogleOAuth__ClientId phía backend).
VITE_GOOGLE_CLIENT_ID=
# GA4 Measurement ID (dạng G-XXXXXXX) — Google Analytics Data Streams. Public, không phải secret.
# Nhúng vào index.html qua Vite HTML env replacement (%VITE_GA4_MEASUREMENT_ID%).
# Xem docs/features/analytics/00-README-kien-truc-tracking.md + docs/ops/DEPLOYMENT-GUIDE.md.
VITE_GA4_MEASUREMENT_ID=
# GA4 Property ID (số, khác Measurement ID) — dùng để nút "Mở Google Analytics" trong
# Dashboard admin trỏ đúng property. Lấy tại Google Analytics → Admin → Property Settings.
VITE_GA4_PROPERTY_ID=
